<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Solo Windows: TIA Portal solo existe en Windows. Openness va en el puente de TIA-Connector, no aquí -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HerramientasSICAR</AssemblyName>
    <RootNamespace>HerramientasSICAR</RootNamespace>
    <Version>2.8.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\alomatek.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Al publicar con -r win-x64 sale un único .exe con todo dentro (también las nativas de dibujo de Avalonia).
       Va condicionado al RuntimeIdentifier para que compilar y pasar los tests no lo pidan -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\alomatek.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.16.0" />
    <!-- DocumentFormat.OpenXml 2.16 trae System.IO.Packaging 6.0.0, con un fallo de seguridad conocido -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="GTranslate" Version="2.3.1" />
  </ItemGroup>

  <!-- TIA-Connector (submódulo en external/): todo lo que se hace con TIA pasa por su cliente, que lleva dentro el
       puente (un .exe aparte que es el único que carga Openness) -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\TIA-Connector\src\TiaConnector.Client\TiaConnector.Client.csproj" />
  </ItemGroup>

</Project>
