<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HerramientasSICAR.Controls">

    <!-- Tokens de color: un acento azul, superficies neutras y tres colores de estado -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="App.Background" Color="#F4F6F9" />
                    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="App.SurfaceHover" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="App.Border" Color="#E2E6EC" />
                    <SolidColorBrush x:Key="App.Text" Color="#18202B" />
                    <SolidColorBrush x:Key="App.TextMuted" Color="#667085" />
                    <SolidColorBrush x:Key="App.Accent" Color="#2563EB" />
                    <SolidColorBrush x:Key="App.AccentSoft" Color="#E8EFFD" />
                    <SolidColorBrush x:Key="App.AccentText" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="App.Good" Color="#15803D" />
                    <SolidColorBrush x:Key="App.GoodSoft" Color="#DCFCE7" />
                    <SolidColorBrush x:Key="App.Warn" Color="#B45309" />
                    <SolidColorBrush x:Key="App.WarnSoft" Color="#FEF3C7" />
                    <SolidColorBrush x:Key="App.Bad" Color="#DC2626" />
                    <SolidColorBrush x:Key="App.BadSoft" Color="#FEE2E2" />
                    <BoxShadows x:Key="App.Shadow">0 1 2 0 #0F172A14, 0 1 3 0 #0F172A0D</BoxShadows>
                    <!-- Desplegables (barra de avisos) sin fondo propio, sobre la barra -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="App.Background" Color="#0F1115" />
                    <SolidColorBrush x:Key="App.Surface" Color="#171A20" />
                    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#1D2129" />
                    <SolidColorBrush x:Key="App.SurfaceHover" Color="#232833" />
                    <SolidColorBrush x:Key="App.Border" Color="#2A2F3A" />
                    <SolidColorBrush x:Key="App.Text" Color="#E7EAF0" />
                    <SolidColorBrush x:Key="App.TextMuted" Color="#9099A8" />
                    <SolidColorBrush x:Key="App.Accent" Color="#3B82F6" />
                    <SolidColorBrush x:Key="App.AccentSoft" Color="#1B2A45" />
                    <SolidColorBrush x:Key="App.AccentText" Color="#93B8FB" />
                    <SolidColorBrush x:Key="App.Good" Color="#4ADE80" />
                    <SolidColorBrush x:Key="App.GoodSoft" Color="#163322" />
                    <SolidColorBrush x:Key="App.Warn" Color="#FBBF24" />
                    <SolidColorBrush x:Key="App.WarnSoft" Color="#3A2E12" />
                    <SolidColorBrush x:Key="App.Bad" Color="#F87171" />
                    <SolidColorBrush x:Key="App.BadSoft" Color="#3B1C1F" />
                    <BoxShadows x:Key="App.Shadow">0 1 2 0 #00000040</BoxShadows>
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#232833" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#232833" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Base -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource App.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Textos -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo en mayúsculas de una sección o columna -->
    <Style Selector="TextBlock.caption, TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.badge">
        <Setter Property="Foreground" Value="{DynamicResource App.Warn}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tarjetas, barras y separadores -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BoxShadow" Value="{DynamicResource App.Shadow}" />
    </Style>
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>
    <!-- Cabecera de un editor: título a la izquierda y acciones a la derecha -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Border.side">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Height" Value="1" />
    </Style>
    <Style Selector="Border.vdivider">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.brand">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>
    <!-- Icono grande del estado vacío -->
    <Style Selector="Border.emptyicon">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.emptyicon c|Icon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
    </Style>

    <!-- Pastillas (contadores, estado) -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Border.pill.accent">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="Border.pill.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
    </Style>
    <Style Selector="Border.pill.warn">
        <Setter Property="Background" Value="{DynamicResource App.WarnSoft}" />
    </Style>
    <Style Selector="Border.pill.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Warn}" />
    </Style>
    <Style Selector="Border.pill.good">
        <Setter Property="Background" Value="{DynamicResource App.GoodSoft}" />
    </Style>
    <Style Selector="Border.pill.good TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Good}" />
    </Style>
    <Style Selector="Border.pill.bad">
        <Setter Property="Background" Value="{DynamicResource App.BadSoft}" />
    </Style>
    <Style Selector="Border.pill.bad TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
    </Style>
    <!-- Nota de ayuda dentro de un editor -->
    <Style Selector="Border.tip">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <!-- Aviso de versión nueva -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Botones: por defecto secundario (fondo de superficie y borde), acento para la acción principal
         y fantasma para los de solo icono -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
    </Style>
    <!-- Deshabilitados: el mismo aspecto, atenuado (no el bloque gris de Fluent) -->
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button c|Icon">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Referencias de una location: casillas que se encienden con el acento -->
    <Style Selector="ToggleButton.ref">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.ref:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="ToggleButton.ref:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Barra superior: en una ventana estrecha los botones se quedan con el icono -->
    <Style Selector="Window.narrow TextBlock.barlabel">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Listas laterales (operaciones, devices, tipos): filas redondeadas con selección suave -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cards">
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>

    <!-- Tablas (locations, direcciones, variables): filas con separador y hover, selección suave -->
    <Style Selector="ListBox.table">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem">
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="Border.tablehead">
        <Setter Property="Padding" Value="14,10,14,8" />
    </Style>

    <!-- Árboles (proyecto y assets): selección suave y esquinas redondeadas -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
    </Style>
    <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>

    <!-- Pestañas compactas -->
    <Style Selector="TabControl.compact">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.compact TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="2,0,18,0" />
    </Style>

    <!-- Campos -->
    <Style Selector="TextBox, AutoCompleteBox, ComboBox, NumericUpDown">
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <!-- Celdas editables de las tablas: sin marco hasta pasar por encima o editarlas -->
    <Style Selector="TextBox.cell">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>
</Styles>
