<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HerramientasSICAR.ViewModels"
        xmlns:v="using:HerramientasSICAR.Views"
        xmlns:c="using:HerramientasSICAR.Controls"
        xmlns:l="using:HerramientasSICAR"
        x:Class="HerramientasSICAR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/alomatek.png"
        Title="{Binding Title}"
        Width="1240" Height="800" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ImportExportViewModel"><v:ImportExportView /></DataTemplate>
        <DataTemplate DataType="vm:DiagExpectedViewModel"><v:DiagExpectedView /></DataTemplate>
        <DataTemplate DataType="vm:MessageNumberingViewModel"><v:MessageNumberingView /></DataTemplate>
        <DataTemplate DataType="vm:RenumberArrayViewModel"><v:RenumberArrayView /></DataTemplate>
        <DataTemplate DataType="vm:SyncCheckerViewModel"><v:SyncCheckerView /></DataTemplate>
        <DataTemplate DataType="vm:CommentatorViewModel"><v:CommentatorView /></DataTemplate>
        <DataTemplate DataType="vm:HmiGeneratorViewModel"><v:HmiGeneratorView /></DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- ░░ Barra superior: marca, proyecto de TIA y apariencia ░░ -->
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- El nombre se recorta con «…» antes de pisar los botones -->
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Image Source="/Assets/alomatek.png" Width="32" Height="32" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="label" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Proyecto abierto en TIA y conexión -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0">
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              Width="340" PlaceholderText="{Binding ChooseProjectText}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="ghost" Command="{Binding FindProjectsCommand}" ToolTip.Tip="{l:T 'Buscar proyectos abiertos en TIA'}">
                        <c:Icon Kind="refresh" Width="17" Height="17" />
                    </Button>
                    <Button Classes="accent" Command="{Binding ConnectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="link" />
                            <TextBlock Text="{l:T 'Conectar'}" Classes="barlabel" />
                        </StackPanel>
                    </Button>
                    <Border Classes="pill good" IsVisible="{Binding ToolContext.Connected}" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding ToolContext.ConnectedProject}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <c:Icon Kind="check" Width="12" Height="12" Foreground="{DynamicResource App.Good}" />
                            <TextBlock Text="{Binding ToolContext.ProjectName}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Apariencia -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Border Classes="vdivider" />
                    <Button Classes="ghost" ToolTip.Tip="{l:T 'Idioma'}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <c:Icon Kind="globe" Width="17" Height="17" />
                            <TextBlock Text="{Binding LanguageText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Castellano" ToggleType="Radio" GroupName="language" IsChecked="{Binding InSpanish, Mode=OneWay}"
                                          Command="{Binding ChangeLanguageCommand}" CommandParameter="es" />
                                <MenuItem Header="English" ToggleType="Radio" GroupName="language" IsChecked="{Binding InEnglish, Mode=OneWay}"
                                          Command="{Binding ChangeLanguageCommand}" CommandParameter="en" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost" ToolTip.Tip="{l:T 'Tema'}">
                        <c:Icon Kind="{Binding ThemeIcon}" Width="17" Height="17" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{l:T 'Sistema'}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding SystemTheme, Mode=OneWay}"
                                          Command="{Binding ChangeThemeCommand}" CommandParameter="system" />
                                <MenuItem Header="{l:T 'Claro'}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding LightTheme, Mode=OneWay}"
                                          Command="{Binding ChangeThemeCommand}" CommandParameter="light" />
                                <MenuItem Header="{l:T 'Oscuro'}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding DarkTheme, Mode=OneWay}"
                                          Command="{Binding ChangeThemeCommand}" CommandParameter="dark" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost" Command="{Binding AboutCommand}" ToolTip.Tip="{l:T 'Acerca de'}">
                        <c:Icon Kind="info" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ░░ Aviso de versión nueva ░░ -->
        <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding HasNewVersion}" Padding="16,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding CloseVersionNoticeCommand}" Padding="5" ToolTip.Tip="{l:T 'Cerrar'}">
                    <c:Icon Kind="x" Width="14" Height="14" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <c:Icon Kind="download" Width="15" Height="15" Foreground="{DynamicResource App.AccentText}" />
                    <TextBlock Text="{Binding VersionNotice}" VerticalAlignment="Center" Foreground="{DynamicResource App.AccentText}" FontWeight="Medium" />
                    <HyperlinkButton Content="{l:T 'Descargar'}" NavigateUri="{Binding VersionUrl}" Padding="0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ░░ Barra inferior: estado y lista de errores ░░ -->
        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="90" Margin="0,0,16,0"
                             VerticalAlignment="Center" IsVisible="{Binding ToolContext.Busy}" />
                <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,8" IsVisible="{Binding !ToolContext.HasFailures}">
                        <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Bad}" IsVisible="{Binding ToolContext.StatusError}" />
                        <c:Icon Kind="info" Width="14" Height="14" Foreground="{DynamicResource App.TextMuted}" IsVisible="{Binding ToolContext.StatusNormal}" />
                        <TextBlock Text="{Binding ToolContext.Status}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ToolContext.Status}" />
                    </StackPanel>
                    <Expander IsVisible="{Binding ToolContext.HasFailures}" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0"
                              Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Warn}" />
                                <TextBlock Text="{Binding ToolContext.Status}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <ListBox Classes="table" ItemsSource="{Binding ToolContext.Failures}" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </Panel>
            </DockPanel>
        </Border>

        <Grid x:Name="Body" ColumnDefinitions="Auto,*">
            <!-- ░░ Lateral: herramientas, que se puede ocultar ░░ -->
            <Border x:Name="Side" Classes="side" Width="230" IsVisible="{Binding !SidebarHidden}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Classes="ghost" HorizontalAlignment="Right" Margin="0,8,8,0"
                            Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{l:T 'Ocultar las herramientas'}"
                            AutomationProperties.Name="{l:T 'Ocultar las herramientas'}">
                        <c:Icon Kind="panel-left-close" Width="16" Height="16" />
                    </Button>
                    <ListBox Classes="cards nav" ItemsSource="{Binding Sidebar}" SelectedItem="{Binding SelectedTool}" Margin="0,2,0,8">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:Tool">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Kind="{Binding Icon}" Width="16" Height="16" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
            <!-- Con el lateral oculto: botón para mostrarlo y desplegable para cambiar de herramienta -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="24,14,24,0" IsVisible="{Binding SidebarHidden}">
                <Button Classes="ghost" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{l:T 'Mostrar las herramientas'}"
                        AutomationProperties.Name="{l:T 'Mostrar las herramientas'}">
                    <c:Icon Kind="panel-left-open" Width="16" Height="16" />
                </Button>
                <ComboBox ItemsSource="{Binding Sidebar}" SelectedItem="{Binding SelectedTool}" MinWidth="240"
                          ToolTip.Tip="{l:T 'Cambiar de herramienta'}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:Tool">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:Icon Kind="{Binding Icon}" Width="16" Height="16" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- ░░ Panel principal: cabecera de la herramienta y su pantalla ░░ -->
            <DockPanel DataContext="{Binding Current}" x:DataType="vm:Tool">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="24,20,24,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:Icon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource App.Accent}" />
                        <TextBlock Text="{Binding Name}" Classes="h1" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Classes="muted" MaxWidth="820" HorizontalAlignment="Left" />
                    <Border Classes="tip" IsVisible="{Binding NeedsConnection}" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon Kind="link" Width="15" Height="15" Foreground="{DynamicResource App.AccentText}" />
                            <TextBlock Foreground="{DynamicResource App.AccentText}" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="700"
                                       Text="{l:T 'Conecta con un proyecto de TIA en la barra superior.'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ContentControl Content="{Binding}" />
            </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
