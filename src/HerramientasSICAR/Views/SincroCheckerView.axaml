<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.SincroCheckerView"
             x:DataType="vm:SincroCheckerViewModel">
    <DockPanel Margin="24,0,24,16">
        <!-- ░░ Programa a comprobar ░░ -->
        <Border DockPanel.Dock="Top" Classes="card">
            <StackPanel Spacing="10">
                <WrapPanel>
                    <Button Classes="accent" Command="{Binding ExportarDesdeTiaCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="download" />
                            <TextBlock Text="{l:T 'Exportar el PLC desde TIA y comprobar'}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AbrirCarpetaCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="folder" />
                            <TextBlock Text="{l:T 'Abrir una carpeta exportada…'}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding Carpeta}" Classes="label" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Carpeta}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T 'Se lee el programa entero del PLC: así se siguen las condiciones de activación de las señales.'}" />
            </StackPanel>
        </Border>

        <!-- ░░ Resultado ░░ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,12" IsVisible="{Binding HayPrograma}">
            <c:Icon Kind="circle-x" Width="18" Height="18" Foreground="{DynamicResource App.Bad}" IsVisible="{Binding ResumenConPares}" />
            <c:Icon Kind="circle-check" Width="18" Height="18" Foreground="{DynamicResource App.Good}" IsVisible="{Binding !ResumenConPares}" />
            <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ░░ Decisiones guardadas ░░ -->
        <Expander DockPanel.Dock="Bottom" Header="{Binding TituloGrupos}" IsVisible="{Binding HayGrupos}" HorizontalAlignment="Stretch" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Grupos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilaGrupo">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                            <StackPanel>
                                <TextBlock Text="{Binding Texto}" Classes="mono" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Nota}" Classes="label" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost danger" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Borrar esta decisión'}"
                                    AutomationProperties.Name="{l:T 'Borrar esta decisión'}"
                                    Command="{Binding $parent[ItemsControl].((vm:SincroCheckerViewModel)DataContext).BorrarGrupoCommand}" CommandParameter="{Binding}">
                                <c:Icon Kind="trash" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Grid ColumnDefinitions="300,*" ColumnSpacing="14" IsVisible="{Binding HayPares}">
            <!-- Secuencias con pares -->
            <ListBox Classes="table" ItemsSource="{Binding Secuencias}" SelectedItem="{Binding SecuenciaSeleccionada}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilaSecuencia">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Texto}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Texto}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill warn"><TextBlock Text="{Binding Cantidad}" /></Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
                <!-- Pares de la secuencia -->
                <ListBox Classes="table" ItemsSource="{Binding Pares}" SelectedItem="{Binding ParSeleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilaPar">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding PasoA}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PasoA}" />
                                <TextBlock Text="{Binding PasoB}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PasoB}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Decidir sobre el par elegido -->
                <Border Grid.Row="1" Classes="card" IsVisible="{Binding HayPar}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="{l:T '¿Estas señales son excluyentes?'}" IsVisible="{Binding HayCandidatas}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HayCandidatas}"
                                   Text="{l:T 'Cada una la exige uno de los dos pasos y el otro no. Si nunca pueden estar a 1 a la vez, márcalas: este par y los que dependan de ellas dejarán de salir.'}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding SinCandidatas}"
                                   Text="{l:T 'Ningún paso exige una señal a 1 que el otro no exija: los dos pasos no se distinguen por sus señales. Revisa sus interlocks en TIA.'}" />
                        <ScrollViewer MaxHeight="170" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Candidatas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilaCandidata">
                                        <CheckBox IsChecked="{Binding Marcada}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nombre}" Classes="mono" />
                                                <TextBlock Text="{Binding Comentario}" Classes="label" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Classes="accent" HorizontalAlignment="Left" Command="{Binding MarcarExcluyentesCommand}" IsVisible="{Binding HayCandidatas}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Kind="check" />
                                <TextBlock Text="{l:T 'Marcar como excluyentes'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
