<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.GeneradorHmiView"
             x:DataType="vm:GeneradorHmiViewModel">
    <DockPanel Margin="24,0,24,16">
        <!-- ░░ Proyecto: archivo, idioma, traducir y generar ░░ -->
        <Border DockPanel.Dock="Top" Classes="card">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Command="{Binding NuevoCommand}" ToolTip.Tip="{l:T 'Proyecto nuevo'}" AutomationProperties.Name="{l:T 'Proyecto nuevo'}">
                        <c:Icon Kind="file-plus" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding AbrirCommand}" ToolTip.Tip="{l:T 'Abrir un proyecto…'}" AutomationProperties.Name="{l:T 'Abrir un proyecto…'}">
                        <c:Icon Kind="folder" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding GuardarCommand}" ToolTip.Tip="{l:T 'Guardar'}" AutomationProperties.Name="{l:T 'Guardar'}">
                        <c:Icon Kind="save" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding GuardarComoCommand}" ToolTip.Tip="{l:T 'Guardar como… (exportar la configuración)'}">
                        <TextBlock Text="{l:T 'Guardar como…'}" />
                    </Button>
                    <TextBlock Text="{Binding NombreArchivo}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RutaProyecto}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{l:T 'Editar'}" Classes="label" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Idiomas}" SelectedIndex="{Binding IdiomaIndice}" MinWidth="200" />
                    <Button Command="{Binding TraducirCommand}" ToolTip.Tip="{l:T 'Rellena el inglés y el alemán que falten con un traductor en línea'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="languages" />
                            <TextBlock Text="{l:T 'Traducir'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="accent" Command="{Binding GenerarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="file-code" />
                            <TextBlock Text="{l:T 'Generar FC y listas'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ░░ HMIs del PLC ░░ -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{l:T 'HMI'}" />
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Hmis}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HmiEditable">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,6">
                                    <TextBox Text="{Binding Nombre}" Width="120" AutomationProperties.Name="{l:T 'Nombre de la HMI'}" />
                                    <NumericUpDown Value="{Binding Numero}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="100"
                                                   ToolTip.Tip="{Binding Idb}" AutomationProperties.Name="{l:T 'Número de IDB'}" />
                                    <Button Classes="ghost danger" ToolTip.Tip="{l:T 'Quitar esta HMI'}" AutomationProperties.Name="{l:T 'Quitar esta HMI'}"
                                            Command="{Binding $parent[UserControl].((vm:GeneradorHmiViewModel)DataContext).QuitarHmiCommand}" CommandParameter="{Binding}">
                                        <c:Icon Kind="trash" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding AnadirHmiCommand}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="plus" />
                            <TextBlock Text="{l:T 'Añadir HMI'}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T 'El número de cada HMI elige su IDB (HMIMenusConfigNN_IDB). El FC lleva siempre todas las HMI.'}" />
            </StackPanel>
        </Border>

        <TabControl Classes="compact" Margin="0,12,0,0">
            <!-- ░░ Pantallas de los menús ░░ -->
            <TabItem Header="{l:T 'Pantallas'}">
                <Grid ColumnDefinitions="250,*" ColumnSpacing="14" Margin="0,8,0,0">
                    <ListBox Classes="table" ItemsSource="{Binding Subgrupos}" SelectedItem="{Binding SubgrupoSeleccionado}">
                        <ListBox.Styles>
                            <!-- Los rótulos de grupo no se pueden seleccionar -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="IsEnabled" Value="{ReflectionBinding EsSeleccionable}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubgrupoEditable">
                                <Panel>
                                    <TextBlock Text="{Binding Rotulo}" Classes="caption" IsVisible="{Binding EsRotulo}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Nombre}" IsVisible="{Binding EsSeleccionable}" Margin="10,0,0,0" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding NotaSubgrupo}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding EsOem}">
                                <TextBlock Text="{l:T 'Título del grupo OEM'}" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                         Text="{Binding TituloOem.Valor, FallbackValue=''}" Watermark="{Binding TituloOem.MarcaDeAgua, FallbackValue=''}" />
                            </Grid>
                        </StackPanel>

                        <!-- Cabecera: una columna por HMI; al pulsarla se marcan o desmarcan todas -->
                        <Border DockPanel.Dock="Top" Classes="tablehead">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'Pos.'}" Classes="columnHeader" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:T 'Nombre de la pantalla'}" Classes="columnHeader" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Hmis}" IsVisible="{Binding TieneCasillas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HmiEditable">
                                            <Button Classes="ghost" Width="84" Padding="2" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="{l:T 'Marcar o desmarcar todas en esta HMI'}"
                                                    Command="{Binding $parent[UserControl].((vm:GeneradorHmiViewModel)DataContext).AlternarColumnaCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Nombre}" Classes="columnHeader" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Filas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilaPantalla">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" Margin="14,2">
                                            <TextBlock Text="{Binding Posicion}" Classes="mono" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Nombre.Valor, FallbackValue=''}" Watermark="{Binding Nombre.MarcaDeAgua, FallbackValue=''}"
                                                     IsVisible="{Binding TieneNombre}" />
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Casillas}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CasillaVisible">
                                                        <Panel Width="84">
                                                            <CheckBox IsChecked="{Binding Visible}" IsVisible="{Binding Existe}" HorizontalAlignment="Center"
                                                                      ToolTip.Tip="{l:T 'Se ve en esta HMI'}" />
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ░░ Funciones de usuario ░░ -->
            <TabItem Header="{l:T 'Funciones de usuario'}">
                <Grid ColumnDefinitions="250,*" ColumnSpacing="14" Margin="0,8,0,0">
                    <ListBox Classes="table" ItemsSource="{Binding PantallasFunciones}" SelectedItem="{Binding PantallaSeleccionada}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PantallaFunciones">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Titulo}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="pill"><TextBlock Text="{Binding Configuradas}" /></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{l:T 'El título de cada pantalla es el nombre de su posición en Manual operations › User functions. Una función sin ningún texto sale con los textos estándar; si tiene alguno, lo vacío sale vacío.'}" />
                        <Border DockPanel.Dock="Top" Classes="tablehead">
                            <Grid ColumnDefinitions="30,2*,*,*,*,*" ColumnSpacing="8">
                                <TextBlock Text="#" Classes="columnHeader" />
                                <TextBlock Grid.Column="1" Text="{l:T 'Nombre'}" Classes="columnHeader" />
                                <TextBlock Grid.Column="2" Text="{l:T 'Acción izquierda'}" Classes="columnHeader" />
                                <TextBlock Grid.Column="3" Text="{l:T 'Acción derecha'}" Classes="columnHeader" />
                                <TextBlock Grid.Column="4" Text="{l:T 'Feedback izquierda'}" Classes="columnHeader" />
                                <TextBlock Grid.Column="5" Text="{l:T 'Feedback derecha'}" Classes="columnHeader" />
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PantallaSeleccionada.Funciones, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilaFuncion">
                                        <Grid ColumnDefinitions="30,2*,*,*,*,*" ColumnSpacing="8" Margin="14,2">
                                            <TextBlock Text="{Binding Numero}" Classes="mono" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Nombre.Valor}" Watermark="{Binding Nombre.MarcaDeAgua}" />
                                            <TextBox Grid.Column="2" Text="{Binding AccionIzquierda.Valor}" Watermark="{Binding AccionIzquierda.MarcaDeAgua}" />
                                            <TextBox Grid.Column="3" Text="{Binding AccionDerecha.Valor}" Watermark="{Binding AccionDerecha.MarcaDeAgua}" />
                                            <TextBox Grid.Column="4" Text="{Binding FeedbackIzquierda.Valor}" Watermark="{Binding FeedbackIzquierda.MarcaDeAgua}" />
                                            <TextBox Grid.Column="5" Text="{Binding FeedbackDerecha.Valor}" Watermark="{Binding FeedbackDerecha.MarcaDeAgua}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
