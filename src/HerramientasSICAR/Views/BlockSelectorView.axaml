<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.BlockSelectorView"
             x:DataType="vm:BlockSelector">
    <!-- Selector de bloques común a las herramientas: el árbol del proyecto (el de Importar / Exportar) filtrado -->
    <Border Classes="card" Padding="6,12,6,6">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{l:T 'BLOQUES DEL PROYECTO'}" Classes="caption" Margin="10,0,4,8" />
            <TextBox DockPanel.Dock="Top" Margin="4,0,4,8" Text="{Binding FilterText}" PlaceholderText="{l:T 'Filtrar por nombre'}"
                     IsVisible="{Binding HasPlcs}">
                <TextBox.InnerLeftContent>
                    <c:Icon Kind="search" Width="14" Height="14" Margin="10,0,0,0" Foreground="{DynamicResource App.TextMuted}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button DockPanel.Dock="Top" Margin="4,0,4,8" HorizontalAlignment="Stretch" Command="{Binding ReadCommand}" IsVisible="{Binding HasPlcs}"
                    ToolTip.Tip="{l:T 'Trae de TIA el árbol del PLC seleccionado: si no se leyó al conectar, o para ver cambios hechos en TIA'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="refresh" />
                    <TextBlock Text="{Binding ReadText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,4" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasPlcs}"
                       Text="{l:T 'Conecta con un proyecto para ver sus bloques.'}" />
            <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:TreeNode" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                      IsVisible="{Binding $parent[UserControl].((vm:BlockSelector)DataContext).WithCheckBoxes}" />
                            <c:Icon Grid.Column="1" Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.TextMuted}" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="label" FontSize="11.5" Margin="4,0,6,0" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:TreeNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsVisible" Value="{Binding Visible}" />
                    </Style>
                </TreeView.Styles>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
