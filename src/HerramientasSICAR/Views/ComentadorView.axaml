<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.ComentadorView"
             x:DataType="vm:ComentadorViewModel">
    <DockPanel Margin="24,0,24,16">
        <!-- ░░ Opciones y acciones ░░ -->
        <Border DockPanel.Dock="Top" Classes="card">
            <StackPanel Spacing="12">
                <WrapPanel>
                    <Button Command="{Binding BuscarFbsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="search" />
                            <TextBlock Text="{l:T 'Buscar FB de secuencia'}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Plc}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </WrapPanel>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{l:T 'Los títulos están en'}" Classes="label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Idiomas}" SelectedIndex="{Binding IdiomaIndice}" MinWidth="140" />
                    <CheckBox Grid.Column="2" IsChecked="{Binding Traducir}" Margin="12,0,0,0"
                              Content="{l:T 'Traducir a los otros dos idiomas (necesita internet)'}" />
                    <Button Grid.Column="3" Classes="accent" Command="{Binding ComentarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="languages" />
                            <TextBlock Text="{l:T 'Comentar'}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T 'Cada segmento con título recibe un comentario de tres líneas (Title_english, Title_deutsch y Title_espanol) con el título sin el número de paso, en el idioma del proyecto (en-US). Se sobrescribe el comentario que tuviera. Los FB se exportan a una carpeta temporal, se importan en TIA sobrescribiéndolos y la carpeta se borra.'}" />
            </StackPanel>
        </Border>

        <!-- ░░ FB encontrados ░░ -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,6" IsVisible="{Binding HayFbs}">
            <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding MarcarTodosCommand}" Content="{l:T 'Marcar todos'}" />
            <Button Grid.Column="2" Classes="ghost" Command="{Binding MarcarNingunoCommand}" Content="{l:T 'Ninguno'}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding SinFbs}"
                   Text="{Binding Ayuda}" />

        <ListBox Classes="table" ItemsSource="{Binding Fbs}" IsVisible="{Binding HayFbs}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilaFbComentador">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <CheckBox IsChecked="{Binding Marcado}" IsEnabled="{Binding SePuedeMarcar}" AutomationProperties.Name="{Binding Nombre}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Carpeta}" Classes="label" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill warn" IsVisible="{Binding Protegido}" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'protegido'}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
