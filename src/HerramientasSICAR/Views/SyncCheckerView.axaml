<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.SyncCheckerView"
             x:DataType="vm:SyncCheckerViewModel">
    <DockPanel Margin="24,0,24,16">
        <!-- ░░ Programa a comprobar y resultado, en una fila ░░ -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <Button Classes="accent" Command="{Binding ExportFromTiaCommand}"
                    ToolTip.Tip="{l:T 'Se lee el programa entero del PLC: así se siguen las condiciones de activación de las señales.'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="download" />
                    <TextBlock Text="{l:T 'Exportar el PLC desde TIA y comprobar'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="folder" />
                    <TextBlock Text="{l:T 'Abrir una carpeta exportada…'}" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Text="{Binding Folder}" Classes="label" VerticalAlignment="Center"
                       TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProgram}">
                <c:Icon Kind="circle-x" Width="18" Height="18" Foreground="{DynamicResource App.Bad}" IsVisible="{Binding SummaryWithPairs}" />
                <c:Icon Kind="circle-check" Width="18" Height="18" Foreground="{DynamicResource App.Good}" IsVisible="{Binding !SummaryWithPairs}" />
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Pares arriba y decisiones guardadas abajo: la separación se arrastra y las decisiones se pliegan -->
        <Grid x:Name="Body" RowDefinitions="*,Auto,Auto">
            <!-- Tres columnas (OM, pares, ladder) con separaciones que se arrastran para dar sitio al ladder -->
            <Grid ColumnDefinitions="260,Auto,280,Auto,*" IsVisible="{Binding HasPairs}">
                <!-- Secuencias con pares -->
                <!-- Secuencias con pares, por OM -->
                <Border Classes="card" Padding="4">
                    <TreeView ItemsSource="{Binding ResultTree}" SelectedItem="{Binding SelectedResult}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="vm:ResultNode" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="pill warn"><TextBlock Text="{Binding Count}" /></Border>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:ResultNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </Border>

                <!-- Pares de la secuencia -->
                <GridSplitter Grid.Column="1" Width="14" ResizeDirection="Columns" Background="Transparent" />

                <ListBox Grid.Column="2" Classes="table" MinWidth="120" ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PairRow">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding StepAName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StepAName}" />
                                <TextBlock Text="{Binding StepBName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StepBName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Ladder de los dos pasos del par arriba y decisión sobre el par abajo, con la separación arrastrable -->
                <GridSplitter Grid.Column="3" Width="14" ResizeDirection="Columns" Background="Transparent" />

                <Grid x:Name="PairArea" Grid.Column="4" RowDefinitions="*,Auto,Auto">
                    <Border Classes="card" MinHeight="120" IsVisible="{Binding HasPair}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                                <TextBlock Classes="label" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{l:T 'Verde: conduce · Rojo: no conduce · Clic: cambiar la señal · Clic derecho: añadir a excluyentes'}"
                                           ToolTip.Tip="{l:T 'Estado de señales en el que los dos pasos son candidatos a la vez.'}" />
                                <Button Grid.Column="1" Command="{Binding ResetStateCommand}" IsVisible="{Binding StateChanged}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:Icon Kind="rotate-ccw" />
                                        <TextBlock Text="{l:T 'Volver al estado encontrado'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Ladder}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="28" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StepLadderRow">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Classes="pill good" IsVisible="{Binding IsCandidate}"><TextBlock Text="{l:T 'candidato'}" /></Border>
                                                    <Border Classes="pill bad" IsVisible="{Binding IsNotCandidate}"><TextBlock Text="{l:T 'no candidato'}" /></Border>
                                                    <Border Classes="pill" IsVisible="{Binding IsUnknown}"><TextBlock Text="{l:T 'sin decidir'}" /></Border>
                                                </StackPanel>
                                                <TextBlock Classes="muted" IsVisible="{Binding HasNoRungs}" Text="{l:T 'Sin ilockAuto, ilockExtSync, transAuto ni saltos programados.'}" />
                                                <ItemsControl ItemsSource="{Binding Rungs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RungRow">
                                                            <c:LadRungView Rung="{Binding Rung}" State="{Binding State}" HorizontalAlignment="Left" Margin="0,0,0,12" Cursor="Hand"
                                                                           ToggleCommand="{Binding $parent[UserControl].((vm:SyncCheckerViewModel)DataContext).ToggleSignalCommand}"
                                                                           AddCandidateCommand="{Binding $parent[UserControl].((vm:SyncCheckerViewModel)DataContext).AddCandidateCommand}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="DecisionSplitter" Grid.Row="1" Height="12" ResizeDirection="Rows" Background="Transparent"
                                  IsVisible="{Binding HasPair}" />

                    <Border x:Name="DecisionCard" Grid.Row="2" Classes="card" IsVisible="{Binding HasPair}">
                        <Expander x:Name="DecisionPanel" IsExpanded="{Binding DecisionExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Header="{l:T '¿Estas señales son excluyentes?'}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding HasCandidates}"
                                           Text="{l:T 'Las propuestas las exige a 1 uno de los dos pasos y el otro no; las añadidas con clic derecho en el ladder salen con el valor que pide el contacto. Marca las condiciones que nunca se dan a la vez (cambia = 1 / = 0 pulsando): este par y los que dependan de ellas dejarán de salir.'}" />
                                <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoCandidates}"
                                           Text="{l:T 'No hay al menos dos señales que un paso exija a 1 y el otro no: para este par no hay excluyentes que proponer. Revisa sus interlocks en TIA o añade señales a mano con clic derecho en el ladder.'}" />
                                <Button DockPanel.Dock="Bottom" Classes="accent" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding MarkExclusiveCommand}" IsVisible="{Binding HasCandidates}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:Icon Kind="check" />
                                        <TextBlock Text="{l:T 'Marcar como excluyentes'}" />
                                    </StackPanel>
                                </Button>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding CandidateRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CandidateRow">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <CheckBox IsChecked="{Binding IsChecked}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Classes="mono" />
                                                            <TextBlock Text="{Binding CommentText}" Classes="label" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <!-- Valor de la señal en la condición; se cambia pulsando -->
                                                    <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" MinWidth="44"
                                                            Command="{Binding ToggleValueCommand}" ToolTip.Tip="{l:T 'Cambiar entre = 1 y = 0'}">
                                                        <TextBlock Text="{Binding ValueText}" Classes="mono" FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Expander>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter x:Name="SavedSplitter" Grid.Row="1" Height="12" ResizeDirection="Rows" Background="Transparent"
                          IsVisible="{Binding HasGroups}" />

            <!-- ░░ Decisiones guardadas ░░ -->
            <Expander x:Name="SavedPanel" Grid.Row="2" Header="{Binding GroupsTitle}" IsVisible="{Binding HasGroups}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" Classes="mono" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Note}" Classes="label" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost danger" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Borrar esta decisión'}"
                                            AutomationProperties.Name="{l:T 'Borrar esta decisión'}"
                                            Command="{Binding $parent[ItemsControl].((vm:SyncCheckerViewModel)DataContext).DeleteGroupCommand}" CommandParameter="{Binding}">
                                        <c:Icon Kind="trash" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </Grid>
    </DockPanel>
</UserControl>
