<UserControl x:Class="HerramientasSICAR.Views.SincroCheckerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:HerramientasSICAR.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="850"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Sincro Checker"
                      Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Detecta pasos de secuencia cuyos ilocks (ilockAuto + ilockExtSync, junto con PERM) pueden cumplirse a la vez al pasar de manual a automático"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Source Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                        Text="{Binding RutaXml, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="FB de secuencia exportado (.xml)"
                        IsReadOnly="True"
                        Margin="0,0,8,0"/>

                <Button Grid.Row="0" Grid.Column="1"
                       Command="{Binding BuscarXmlCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       materialDesign:ButtonAssist.CornerRadius="4"
                       IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                       Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Abrir bloque" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Expander Grid.Row="1" Grid.ColumnSpan="2"
                         Header="Exportar desde TIA Portal / opciones"
                         Margin="0,8,0,0"
                         Background="Transparent">
                    <StackPanel Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                    Text="{Binding RutaProyecto, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Proyecto .ap19"
                                    IsReadOnly="True"/>
                            <Button Grid.Column="1"
                                   Command="{Binding BuscarProyectoCommand}"
                                   Style="{StaticResource MaterialDesignToolButton}"
                                   ToolTip="Buscar proyecto"
                                   Margin="4,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                            <TextBox Grid.Column="2"
                                    Text="{Binding NombreBloque, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Nombre del bloque"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="3"
                                   Command="{Binding ExportarDesdeTiaCommand}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   materialDesign:ButtonAssist.CornerRadius="4"
                                   IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                                   Content="Exportar y comprobar"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox IsChecked="{Binding ExcluirHomeWork}"
                                     Content="Un actuador no puede estar en -H y -W a la vez"
                                     Margin="0,0,24,0"/>
                            <CheckBox IsChecked="{Binding ExcluirValoresDecodificados}"
                                     Content="Solo un valor activo por señal decodificada (ProcessCode=N, x == N)"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- Status + first manual step -->
        <StackPanel Grid.Row="2" Margin="4,0,0,10">
            <Border Background="#FFF3E0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                   CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                   Visibility="{Binding PedirPrimerManual, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="{StaticResource AccentBrush}"
                                           Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding AvisoPrimerManual}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                IsIndeterminate="True"
                                Width="18" Height="18"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Estado}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Primer paso manual:" VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding PrimerPasoManual, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                            Width="70"
                            materialDesign:HintAssist.Hint="Ninguno"
                            ToolTip="Desde este paso en adelante todos se consideran manuales y no se comprueban"/>
                    <TextBlock Text="{Binding AvisoPrimerManual}" VerticalAlignment="Center" Margin="8,0,0,0"
                              FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                              Visibility="{Binding PedirPrimerManual, Converter={StaticResource InverseBoolToVisConverter}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Conflicts -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COINCIDENCIAS" Style="{StaticResource LabelTextStyle}" Margin="8,8,8,4"/>
                    <ListBox ItemsSource="{Binding Conflictos}"
                            SelectedItem="{Binding ConflictoSeleccionado}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SyncAlert" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12"
                   Visibility="{Binding HayConflictoActivo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,0,8">
                        <Button DockPanel.Dock="Right"
                               Command="{Binding RestaurarEstadoCommand}"
                               Style="{StaticResource MaterialDesignFlatButton}"
                               ToolTip="Volver al estado de ejemplo que provoca la coincidencia">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Estado de ejemplo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ResultadoSincro}" TextWrapping="Wrap" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </DockPanel>

                    <!-- LAD rungs of PERM and both steps -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Secciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                                            <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CloseCircleOutline"/>
                                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Cumple}" Value="True">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Subtitulo}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Segmentos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,4">
                                                        <controls:LadRungView HorizontalAlignment="Left"
                                                                             Expresion="{Binding Expresion}"
                                                                             Bobina="{Binding Bobina}"
                                                                             Estado="{Binding DataContext.EstadoSenales, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             SenalesClave="{Binding DataContext.SenalesClave, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             ToggleCommand="{Binding DataContext.ToggleSenalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#EEEEEE"
                                 ResizeDirection="Rows" ToolTip="Arrastra para cambiar el tamaño"/>

                    <!-- Why they coincide and how to separate them -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel Margin="8,0,8,4">
                                <TextBlock Text="DIFERENCIAS ENTRE LOS DOS PASOS (válidas en cualquier estado; resaltadas en naranja en el LAD)"
                                          TextWrapping="Wrap" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Ningún paso exige siempre una señal que el otro no exija: la coincidencia depende de combinaciones de ramas."
                                          TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Diferencias.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Diferencias}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2,0,4">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Senales}" TextWrapping="Wrap" Foreground="#E65100" Margin="12,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="POR QUÉ COINCIDEN EN ESTE ESTADO"
                                          Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="{Binding ResumenClave}" TextWrapping="Wrap" Foreground="#E65100" Margin="0,0,0,4"/>

                        </StackPanel>
                    </ScrollViewer>

                    <Expander Grid.Row="4" Margin="0,4,0,0" Background="Transparent"
                             Header="Señales implicadas (también se cambian con clic en el contacto)">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Senales}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Valor}" Width="250" Margin="4,2"
                                             ToolTip="{Binding Nombre}">
                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Clave}" Value="True">
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
