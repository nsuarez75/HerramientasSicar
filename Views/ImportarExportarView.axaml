<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HerramientasSICAR.ViewModels"
             xmlns:c="using:HerramientasSICAR.Controls"
             xmlns:l="using:HerramientasSICAR"
             x:Class="HerramientasSICAR.Views.ImportarExportarView"
             x:DataType="vm:ImportarExportarViewModel">
    <Grid ColumnDefinitions="360,Auto,*" Margin="24,0,24,16">
        <!-- ░░ Bloques del proyecto (casilla = exportar, selección = destino de la importación) ░░ -->
        <Border Classes="card" Padding="6,12,6,6">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,0,4,8">
                    <TextBlock Text="{l:T 'BLOQUES'}" Classes="caption" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="pill" Classes.accent="{Binding HayMarcados}" IsVisible="{Binding Contexto.Conectado}">
                        <TextBlock Text="{Binding TextoMarcados}" />
                    </Border>
                </Grid>
                <TextBox DockPanel.Dock="Top" Margin="4,0,4,8" Text="{Binding Filtro}" IsVisible="{Binding Contexto.Conectado}"
                         Watermark="{l:T 'Filtrar por nombre'}">
                    <TextBox.InnerLeftContent>
                        <c:Icon Kind="search" Width="14" Height="14" Margin="10,0,0,0" Foreground="{DynamicResource App.TextMuted}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,4" FontSize="12" IsVisible="{Binding Contexto.SinConectar}"
                           Text="{l:T 'Conecta con un proyecto para ver sus PLC, carpetas y bloques.'}" />
                <TreeView ItemsSource="{Binding Plcs}" SelectedItem="{Binding NodoSeleccionado}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:NodoArbol" ItemsSource="{Binding Hijos}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="1" Kind="{Binding Icono}" Width="15" Height="15" VerticalAlignment="Center"
                                        Foreground="{DynamicResource App.TextMuted}" />
                                <TextBlock Grid.Column="2" Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Detalle}" Classes="label" FontSize="11.5" Margin="4,0,6,0" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:NodoArbol">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsVisible" Value="{Binding Visible}" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="12" ResizeDirection="Columns" Background="Transparent" />

        <!-- ░░ Exportar e importar ░░ -->
        <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Kind="download" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" />
                            <TextBlock Text="{l:T 'Exportar'}" Classes="h2" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Classes="muted"
                                   Text="{l:T 'Marca en el árbol los bloques (marcar una carpeta marca todo lo que tiene dentro). Cada bloque se guarda como XML y las carpetas de TIA se crean como subcarpetas.'}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Classes="accent" VerticalAlignment="Center" Command="{Binding ExportarCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Kind="download" />
                                <TextBlock Text="{l:T 'Exportar marcados…'}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Kind="upload" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" />
                            <TextBlock Text="{l:T 'Importar'}" Classes="h2" />
                        </StackPanel>
                        <TextBlock Classes="muted"
                                   Text="{l:T 'Selecciona en el árbol el PLC o la carpeta destino. Los bloques que ya existan con el mismo nombre se sobrescriben.'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{l:T 'Destino'}" Classes="label" />
                            <Border Classes="pill" Classes.accent="{Binding HayDestino}">
                                <TextBlock Text="{Binding Destino}" />
                            </Border>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding ImportarArchivosCommand}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Uno o varios XML, directos a la carpeta destino'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="file-plus" />
                                    <TextBlock Text="{l:T 'Importar archivos…'}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportarCarpetaCommand}" ToolTip.Tip="{l:T 'Todos los XML de una carpeta; sus subcarpetas se crean como carpetas en TIA'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="folder" />
                                    <TextBlock Text="{l:T 'Importar carpeta…'}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Classes="tip">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:Icon Kind="info" Width="15" Height="15" Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Classes="muted" Foreground="{DynamicResource App.AccentText}" MaxWidth="560"
                                   Text="{l:T 'La aplicación nunca abre, guarda ni cierra el proyecto. Después de importar, guárdalo en TIA. Los bloques sin compilar se compilan antes de exportar; los protegidos con contraseña no se pueden exportar.'}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
